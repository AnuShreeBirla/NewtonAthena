{
  "name": "newton-athena",
  "private": true,
  "version": "0.0.0",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "dev": "vite",
    "electron:dev": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^41.10.7",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "wait-on": "^9.5.1",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.newtonathena.desktop",
    "productName": "Newton Athena",
    "electronLanguages": ["en-US"],
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "Newton Athena uses your camera for the exam preview and periodic local test photos."
      }
    }
  }
}
